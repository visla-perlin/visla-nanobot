# nanobot prod environment
# Sourced by run-local.sh / run-docker.sh (plain sh syntax; $HOME expands at source time).

# -- Environment identity ------------------------------------------------------
NANOBOT_ENV=prod

# Visla admin-api endpoints for this environment. VISLA_CURRENT_USER_URL is
# consumed by config.json via the "${VISLA_CURRENT_USER_URL}" env reference
# (resolved at gateway startup); VISLA_ADMIN_API_BASE_URL is forwarded to
# skills through tools.exec.allowedEnvKeys.
VISLA_ADMIN_API_BASE_URL=https://admin-api.prod01.visla.us
VISLA_CURRENT_USER_URL=https://admin-api.prod01.visla.us/api/my/current-user

# -- Paths -----------------------------------------------------------------------
# Per-environment data dir: config.json + runtime state (sessions, issued
# tokens). Kept separate so both gateways can run at the same time.
NANOBOT_DATA_DIR="$HOME/.nanobot-prod"

# Shared workspace: skills, memory, cron jobs, generated files. Intentionally
# the standard ~/.nanobot/workspace so every environment (and a plain local
# `nanobot` install) sees the same skills; environment differences reach the
# skills only via env vars (VISLA_ADMIN_API_BASE_URL etc.).
NANOBOT_WORKSPACE="$HOME/.nanobot/workspace"

# -- Ports (keep the upstream defaults so existing prod usage stays stable) ----
NANOBOT_GATEWAY_PORT=18790   # gateway /health (loopback)
NANOBOT_WEBSOCKET_PORT=8765  # WebUI / WebSocket channel
NANOBOT_API_PORT=8900        # nanobot serve API (loopback)

# -- Docker-only ----------------------------------------------------------------
NANOBOT_CONTAINER_PREFIX=nanobot-prod
NANOBOT_COMPOSE_PROJECT=nanobot-prod
